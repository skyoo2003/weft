*.dylib

# Test and profiling output
*.test
*.out
coverage.*

# Go workspace files
go.work
go.work.sum

# Build output of the release and docs pipelines. Both are regenerated from
# tracked inputs (.goreleaser.yaml, site/), so neither belongs in the history.
/dist/
/site/public/
/site/resources/
/site/.hugo_build.lock

# Milestone 4 evaluation data: downloaded corpora, the Semantic Scholar response
# cache, committed segments and generated run reports. Gigabytes, and all
# reproducible from docs/EVAL.md. The reference goldens under
# internal/eval/testdata/ are deliberately NOT here — those are the evidence.
/.eval-data/

# Local tooling, editor, and OS noise
.claude/
.ruff_cache/
__pycache__/
.DS_Store
*.swp
.idea/
.vscode/
.changelog.expected

# The bleve comparison index. Multi-gigabyte, rebuildable with `cd bench && go run . -build`.
/bench/.bleve-index/
